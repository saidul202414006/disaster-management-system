# ============================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# Oracle Database Connection
# Change these when moving to a different machine.
DB_USER=system
DB_PASSWORD=your_oracle_password_here
DB_CONNECTION_STRING=localhost:1521/XEPDB1
# Common connection strings:
#   Oracle XE (local):       localhost:1521/XEPDB1  (or XE)
#   Oracle Standard (local): localhost:1521/ORCL
#   Oracle Cloud (ATP):      (use wallet connection string from Oracle Cloud)

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS whitelist)
# Change this if frontend runs on a different port or domain.
FRONTEND_URL=http://localhost:3000
